# KIRAFOREX ADMIN CMS DASHBOARD ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and replace with your actual values

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (For client auth sessions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (CONFIDENTIAL - NEVER EXPOSE TO CLIENT/BROWSER)
# Required for administrative operations, bypass RLS when performing owner actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Owner administrator email for initial provisioning
ADMIN_OWNER_EMAIL=kira@kiraforex.com
